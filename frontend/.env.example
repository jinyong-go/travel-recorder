# 백엔드 API 오리진 (선택 사항, 미설정 시 http://localhost:8080)
# 네이버 OAuth 로그인 시작 주소(/oauth2/authorization/naver)도 이 값을 기준으로 만든다.
VITE_API_BASE_URL=

# 네이버 지도(NAVER Maps) JavaScript SDK v3 Client ID (선택 사항)
# 설정 메뉴에서 지도 표시 방식을 "페이지 내 지도 보기"로 바꾸려면 필요합니다.
# 발급: NCP 콘솔 > Services > Maps > Application 등록 (Web Dynamic Map 이용 신청)
# 값을 넣지 않으면 자동으로 "새 창으로 네이버 지도 열기" 방식으로 동작합니다.
VITE_NAVER_MAP_CLIENT_ID=

# 사진 업로드 제한 (선택 사항, 미설정 시 기본값 사용)
# 백엔드 제한(spring.servlet.multipart.max-file-size / max-request-size, app.upload)과
# 같은 값으로 맞춰야 한다. 프론트엔드 검증은 사용자 편의용이며 최종 검증은 백엔드가 수행한다.
# 사진 1장당 최대 용량(MB, 기본 5)
VITE_MAX_PHOTO_SIZE_MB=
# 한 번에 첨부할 수 있는 전체 용량(MB, 기본 30)
VITE_MAX_PHOTO_TOTAL_MB=
