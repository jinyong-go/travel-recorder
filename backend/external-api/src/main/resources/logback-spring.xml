<?xml version="1.0" encoding="UTF-8"?>
<!--
  로그를 "어디로" 내보낼지만 정한다.

  로거별 레벨과 파일 경로·롤링 값은 application-{local,dev,prod}.yml 의 logging.* 가 소유한다.
  Spring Boot 가 이 파일을 읽은 뒤 그 값들을 덮어쓰므로, 여기에 같은 값을 적으면 둘 중 어느
  쪽이 적용됐는지 읽어서는 알 수 없게 된다.

  파일 이름이 logback.xml 이 아닌 것은 <springProfile> 때문이다. logback.xml 은 Spring 이
  프로파일을 결정하기 전에 logback 이 직접 읽으므로 이 태그가 무시된다.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!--
      prod 만 파일에도 남긴다. 파일 appender 는 여기서 만든다 — LOG_FILE 이 없으면 경로가
      정해지지 않으므로 logging.file.name 을 두지 않는 local·dev 에서 include 하면 기동에 실패한다.
    -->
    <springProfile name="prod">
        <include resource="org/springframework/boot/logging/logback/file-appender.xml"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!--
      prod 가 아닌 모든 경우 — local·dev 와 이름을 알 수 없는 프로파일까지. 조건을 "local,dev" 로
      적으면 오타 난 프로파일로 기동했을 때 root 에 appender 가 하나도 붙지 않아 로그가 통째로
      사라진다. <root> 를 프로파일마다 통째로 두는 것은 Spring Boot 가 지원하는 형태이기 때문이다.
      <root> 안에 <springProfile> 을 넣으면 경고가 난다.

      level 은 Boot 기본값과 같은 바닥값이고 yml 의 logging.level 이 덮는다.
    -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
