# docker compose 가 읽는 로컬 설정. 복사해서 `.env` 로 만들고 값을 채운다 (`.env` 는 커밋하지 않는다).
# 비워 둔 줄은 지우거나 주석 처리한다 — 빈 값도 "설정된 값"이라 백엔드 기본값이 쓰이지 않는다.
# 프론트엔드 개발 서버(npm run dev)는 이 파일이 아니라 frontend/.env 를 읽는다.

# 네이버 로그인 (OAuth 복구 후 사용)
#NAVER_CLIENT_ID=
#NAVER_CLIENT_SECRET=

# NAVER API HUB 지역 검색 (장소 검색 사용 시)
#NAVER_API_CLIENT_ID=
#NAVER_API_CLIENT_SECRET=

# 로컬 DB 비밀번호 (기본 travel). 바꾸면 `docker compose down -v` 로 볼륨을 다시 만들어야 한다.
#DB_PASSWORD=

# 네이버 지도 Client ID — 번들에 들어가는 공개 값. 바꾸면 `docker compose up --build`
#VITE_NAVER_MAP_CLIENT_ID=

# Grafana admin 비밀번호 (기본 admin). 볼륨을 처음 만들 때만 적용된다.
#GRAFANA_ADMIN_PASSWORD=
